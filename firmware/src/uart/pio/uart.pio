.program pio_uart_tx
.side_set 1 opt

; 8N1 TX at 8 PIO clocks per bit (matches UART_LINE_CODING_PIO_CLOCKS_PER_BIT).
; Continuous frames are exactly 10 bit-times (start + 8 data + stop): the next
; wrap to `pull side 1 [7]` asserts the stop bit. Do not add a trailing nop —
; that lengthens the frame and under-runs a nominal 1 Mbaud byte rate.

.wrap_target
    pull        side 1 [7] ; Stop bit / idle-high (8 clocks)
    set x, 7    side 0 [7] ; Start bit (8 clocks)
bitloop:
    out pins, 1
    jmp x-- bitloop [6]    ; 8 data bits × 8 clocks
.wrap

.program pio_uart_tx_cts
.side_set 1 opt

; CTS is active-low. Wait only at the frame boundary so a CTS transition can
; defer the next byte without truncating the one already on the wire.
; When CTS is already granted, the stop bit is still 8 clocks: `pull [6]` is
; 7 clocks and the following `wait` takes the 8th while side-set stays high.
; A longer wait extends idle-high until CTS allows the next frame. Do not
; change `[6]` to `[7]` or the granted-CTS stop bit becomes 9 clocks.
.wrap_target
    pull        side 1 [6] ; 7 clocks of stop bit; wait supplies the 8th.
    wait 0 pin 0          ; Keep idle-high until CTS permits TX.
    set x, 7    side 0 [7]
bitloop_cts:
    out pins, 1
    jmp x-- bitloop_cts [6]
.wrap

.program pio_uart_rx
; 8N1 RX with a 3-sample majority vote on every bit (8 data bits + the stop
; bit), reusing one compact decision tree through the existing bit-count loop.
;
; Samples sit at centre-4, centre, and centre+4 of a 32-clock bit
; (UART_LINE_CODING_PIO_RX_CLOCKS_PER_BIT, set in C), so the vote still spans
; a quarter of the bit. A 16-clock bit only left 3 PIO cycles between arming
; `wait 0 pin` and the next start. At 32 clocks that idle margin is 9 cycles,
; without adding a second stop bit on TX. TX stays at 8 clocks/bit on its own
; divider, so back-to-back frames stay 10 bit-times.
;
; Cycle derivation (P = 32, G = 4, wait-detect start bit = cycle 0):
;   - Loop entry for bit k is at P*(k+1.5) - G. `set x, 8 [31]` then `nop [9]`
;     reaches the first entry (cycle 44): wait + set y + set x is 3 cycles
;     plus a 31-cycle delay (next at 34) plus a 10-cycle nop.
;   - Sample instructions are G cycles apart because each `jmp pin` that leads
;     to the next sample carries `[3]`. The third sample runs only when the
;     first two disagree. Both data-bit tails still total 32 cycles:
;       vote0: 10 to reach vote0 + 1 (jmp !x) + 1 (in) + 1+19 (jmp x--) = 32
;       vote1: 9 to reach vote1 + 1 (jmp !x) + 1 (in) + 1+20 (jmp x--) = 32
;   - X counts 8..0 across 9 passes: X!=0 shifts a data bit, X==0 is the stop
;     bit (voted 1 -> push, voted 0 -> sticky framing error). Y is the constant
;     1 shifted for a voted "1".
;   - Clean-push path arms `wait 0 pin` at cycle 311 (stop entry 300 + 11).
;     The next start bit is at cycle 320, leaving a 9-cycle idle-high margin.
;   - host/python/tests/test_pio_rx_majority.py checks every 1-of-3 pattern,
;     the 2-of-3 stop-bit framing rule, 32-cycle data tails, sample offsets
;     0,4 and 0,4,8, and that 9-cycle margin.
;
; IN shift direction is configured in C as shift-right so LSB-first UART samples
; assemble a natural byte in ISR[31:24]. RX DMA then reads that high byte.

.wrap_target
start:
    wait 0 pin 0            ; Stall until start bit is asserted (cycle 0)
    set y, 1                ; Constant "1" source for voted-1 bit shifts
    set x, 8    [31]        ; Preload bit/stop counter
    nop         [9]         ; With the delay above, reach 4 cycles before
                             ; the first data bit's centre (cycle 44)
bitloop:
    jmp pin, s1_hi [3]       ; sample 1 (centre-4); [3] opens a 4-cycle gap
s1_lo:
    jmp pin, s1_lo_s2_hi [3] ; sample 2 (centre) on the s1=0 path
    jmp vote0 [1]            ; s1=0,s2=0: majority 0; [1] matches the 3-sample arrival
s1_lo_s2_hi:
    jmp pin, vote1           ; sample 3 (centre+4, tie 0,1): 1 -> majority 1
    jmp vote0                ; sample 3 (tie 0,1): 0 -> majority 0
s1_hi:
    jmp pin, s1_hi_s2_hi [3] ; sample 2 (centre) on the s1=1 path
    jmp pin, vote1           ; sample 3 (centre+4, tie 1,0): 1 -> majority 1
    jmp vote0                ; sample 3 (tie 1,0): 0 -> majority 0
s1_hi_s2_hi:
    jmp vote1                ; s1=1,s2=1: majority 1, no 3rd sample needed
vote0:
    jmp !x, stop_bad         ; stop-bit pass: voted 0 is a framing error
    in null, 1               ; data pass: shift voted 0 bit
    jmp x-- bitloop [19]
vote1:
    jmp !x, stop_good        ; stop-bit pass: voted 1 is a clean frame
    in y, 1                  ; data pass: shift voted 1 bit
    jmp x-- bitloop [20]
stop_bad:
    irq set 0 rel            ; Sticky per-SM framing-error flag
    mov isr, null
    wait 1 pin 0
    jmp start
stop_good:
    push block
.wrap
