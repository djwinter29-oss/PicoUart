.program pio_uart_tx
.side_set 1 opt

.wrap_target
    pull        side 1 [7]
    set x, 7    side 0 [7]
bitloop:
    out pins, 1
    jmp x-- bitloop [6]
    nop         side 1 [6]
.wrap

.program pio_uart_rx
; 8N1 RX with stop-bit framing check.
; On a framing error (stop bit low): raise irq 0 rel for this SM, discard the
; partial ISR, wait for the line to return idle-high, then hunt for the next
; start bit. Valid frames are pushed as usual.

.wrap_target
start:
    wait 0 pin 0
    set x, 7 [10]
bitloop:
    in pins, 1
    jmp x-- bitloop [6]
    ; Final not-taken jmp already delayed one bit time to the stop-bit centre.
    jmp pin good_stop
    irq set 0 rel
    mov isr, null
    wait 1 pin 0
    jmp start
good_stop:
    push block
.wrap
