<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pico-uart-dotnet</ToolCommandName>
    <PackageId>PicoUart.DotNet</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <Authors>Ji Dong</Authors>
    <PackageProjectUrl>https://github.com/djwinter29-oss/PicoUart</PackageProjectUrl>
    <RepositoryUrl>https://github.com/djwinter29-oss/PicoUart</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>PicoUart .NET diagnostic CLI and local dashboard for the six-channel USB-to-UART bridge.</Description>
    <PackageTags>pico-uart;raspberry-pi-pico;uart;hid;diagnostics</PackageTags>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerAutoIncrement>patch</MinVerAutoIncrement>
    <MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PicoUart.Tests" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
    <Content Include="../../web/src/**/*" Exclude="../../web/src/**/__pycache__/**">
      <Link>web/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>